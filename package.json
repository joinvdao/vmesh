{
  "name": "vmesh",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace baseline for vmesh, a source-honest geospatial atlas built around a geospatial hex mesh.",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "overrides": {
    "postcss": "^8.5.12"
  },
  "scripts": {
    "dev": "next dev",
    "dev:infisical": "node scripts/run-with-infisical.mjs --path /projects/_shared/providers/mapbox -- npm run dev",
    "build": "next build",
    "start": "next start",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "analyze": "knip --reporter json > knip-report.json",
    "agent-ready:check": "node tools/agent-ready/check.mjs .",
    "janitor": "npm run analyze",
    "janitor:report": "node scripts/janitor-report.mjs",
    "janitor:agent": "node scripts/janitor-agent.mjs",
    "maintenance-day": "node scripts/maintenance-day.mjs",
    "refactor:queue": "node scripts/write-refactor-queue.mjs",
    "public-workflow:check": "node scripts/public-workflow-check.mjs",
    "privacy:check": "node scripts/privacy-check.mjs",
    "intel:refresh": "node scripts/run-vmesh-intel-refresh.mjs",
    "registry:ingest": "node scripts/ingest-intel-source-registry.mjs",
    "registry:refresh-official": "node scripts/refresh-official-stac-endpoints.mjs",
    "registry:prove-global-terrain": "node scripts/prove-global-terrain-matrix.mjs",
    "registry:prove-worldcover": "node scripts/prove-worldcover-matrix.mjs",
    "registry:prove-buildings": "node scripts/prove-building-matrix.mjs",
    "ba:route-proof": "node scripts/ba-source-package-route-proof.mjs",
    "macro:build": "node scripts/build-macro-package.mjs",
    "macro:validate": "node scripts/validate-macro-package.mjs",
    "macro:ready": "node scripts/check-macro-readiness.mjs --fixture",
    "visual:check": "node scripts/visual-regression-check.mjs",
    "terrain:cog-probe": "python scripts/terrain-cog-probe.py",
    "terrain:usgs-render": "python scripts/terrain-usgs-3dep-render.py",
    "terrain:usgs-lpc-dsm-probe": "node scripts/terrain-usgs-lpc-dsm-probe.mjs",
    "terrain:usgs-lpc-asset-manifest": "python scripts/terrain-usgs-lpc-asset-manifest.py",
    "terrain:usgs-lpc-dsm-render": "python scripts/terrain-usgs-lpc-dsm-render.py",
    "terrain:coverage-matrix": "node scripts/terrain-source-coverage-matrix.mjs",
    "terrain:kamloops-audit": "node scripts/kamloops-terrain-coverage-audit.mjs",
    "terrain:kamloops-discovery": "node scripts/kamloops-terrain-source-discovery.mjs",
    "terrain:kamloops-manifest-audit": "node scripts/kamloops-operator-terrain-manifest-audit.mjs",
    "terrain:country-sample-live-proof": "node scripts/terrain-source-country-sample-live-proof.mjs",
    "terrain:route-live-proof": "node scripts/terrain-source-route-live-proof.mjs",
    "terrain:viewer-live-proof": "node scripts/terrain-source-viewer-live-proof.mjs",
    "terrain:probe-live-proof": "node scripts/terrain-source-probe-live-proof.mjs",
    "terrain:source-adapter-live-proof": "vitest run --config vitest.terrain-source-adapter-live.config.ts",
    "terrain:package-live-proof": "vitest run --config vitest.terrain-live.config.ts"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@deck.gl/core": "^9.3.1",
    "@deck.gl/geo-layers": "^9.3.1",
    "@deck.gl/layers": "^9.3.1",
    "@deck.gl/mapbox": "^9.3.1",
    "@mapbox/vector-tile": "^3.0.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@types/three": "^0.184.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "deck.gl": "^9.3.1",
    "h3-js": "^4.4.0",
    "lucide-react": "^1.14.0",
    "maplibre-gl": "^4.7.1",
    "next": "^16.2.4",
    "pbf": "^5.1.2",
    "pg": "^8.22.0",
    "pmtiles": "^4.4.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.184.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/mapbox__vector-tile": "^1.3.4",
    "@types/node": "^25.6.0",
    "@types/pbf": "^3.0.5",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "husky": "^9.1.7",
    "jsdom": "^29.1.0",
    "knip": "^6.9.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.12",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
