# Public map tile endpoint reserved for a future configurable MapLibre style.
# Keep this free/open-source by default; do not commit provider tokens here.
NEXT_PUBLIC_MAP_TILE_URL=

# Optional basemap provider configuration. Keep public demo defaults token-free.
# Supported values: maplibre-demo, openfreemap-vector, protomaps-pmtiles,
# mapbox-satellite-basemap, offline-shell.
NEXT_PUBLIC_BASEMAP_PROVIDER=
NEXT_PUBLIC_BASEMAP_STYLE_URL=
NEXT_PUBLIC_BASEMAP_PMTILES_URL=

# Optional remote geocoding/autocomplete. Defaults to enabled for global
# no-key place search; set to false for privacy-sensitive or offline deployments.
NEXT_PUBLIC_ENABLE_REMOTE_GEOCODING=true

# Optional public raster-dem TileJSON URL. When set, this is the highest-priority
# terrain provider. Keep it token-free unless the deployment environment is
# explicitly configured and reviewed.
# Example shape only: https://example.com/terrain/tiles.json
NEXT_PUBLIC_TERRAIN_TILEJSON_URL=

# Optional terrain provider preference. Supported public values are:
# mapterhorn-pmtiles, mapzen-joerd-terrarium, maplibre-demo-dem.
# Env TileJSON still wins when NEXT_PUBLIC_TERRAIN_TILEJSON_URL is set.
NEXT_PUBLIC_TERRAIN_PROVIDER=

# Optional overrides for the built-in open terrain providers.
NEXT_PUBLIC_MAPTERHORN_PMTILES_URL=https://download.mapterhorn.com/planet.pmtiles
NEXT_PUBLIC_MAPZEN_TERRARIUM_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png

# Optional imagery provider configuration. SEN2SR tiles must be generated by an
# offline/server pipeline, not in the browser. Mapbox is optional and token-gated.
NEXT_PUBLIC_IMAGERY_PROVIDER=
NEXT_PUBLIC_SENTINEL_PREVIEW_TILE_URL=
NEXT_PUBLIC_SEN2SR_PMTILES_URL=
NEXT_PUBLIC_SEN2SR_XYZ_URL=
NEXT_PUBLIC_OFFLINE_RASTER_PMTILES_URL=
# Use MAPBOX_TOKEN for secret-class Mapbox tokens. The public proxy flags only
# expose the local app route, not the provider token. The proxy can support the
# optional Mapbox satellite basemap and imagery layer.
MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_PROXY_ENABLED=
NEXT_PUBLIC_MAPBOX_PROXY_URL=
# Only use NEXT_PUBLIC_MAPBOX_TOKEN for restricted public pk.* Mapbox tokens.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional analytics endpoint. Must never receive raw PII or secrets.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
