# Public map tile endpoint reserved for a future configurable MapLibre style.
# Keep this free/open-source by default; do not commit provider tokens here.
NEXT_PUBLIC_MAP_TILE_URL=

# Optional public raster-dem TileJSON URL. When set, this is the highest-priority
# terrain provider. Keep it token-free unless the deployment environment is
# explicitly configured and reviewed.
# Example shape only: https://example.com/terrain/tiles.json
NEXT_PUBLIC_TERRAIN_TILEJSON_URL=

# Optional analytics endpoint. Must never receive raw PII or secrets.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
