{
  "name": "vmesh",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace baseline for vmesh, an atlas of antifragility built around a geospatial hex mesh.",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "overrides": {
    "postcss": "^8.5.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "analyze": "knip --reporter json > knip-report.json",
    "agent-ready:check": "node tools/agent-ready/check.mjs .",
    "janitor": "npm run analyze",
    "janitor:report": "node scripts/janitor-report.mjs",
    "janitor:agent": "node scripts/janitor-agent.mjs",
    "maintenance-day": "node scripts/maintenance-day.mjs",
    "refactor:queue": "node scripts/write-refactor-queue.mjs",
    "public-workflow:check": "node scripts/public-workflow-check.mjs",
    "privacy:check": "node scripts/privacy-check.mjs"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@deck.gl/core": "^9.3.1",
    "@deck.gl/geo-layers": "^9.3.1",
    "@deck.gl/layers": "^9.3.1",
    "@deck.gl/mapbox": "^9.3.1",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "deck.gl": "^9.3.1",
    "h3-js": "^4.4.0",
    "lucide-react": "^1.14.0",
    "maplibre-gl": "^4.7.1",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "husky": "^9.1.7",
    "jsdom": "^29.1.0",
    "knip": "^6.9.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.12",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
